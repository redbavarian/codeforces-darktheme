{
    "shell_cmd": "g++ -std=c++17 -O2 \"$file\" -o \"$file_path/${file_base_name}\" && \"$file_path/${file_base_name}\" < input.txt > output.txt",
    "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
    "working_dir": "${file_path}",
    "selector": "source.c++, source.cpp",
    "shell": true
}
